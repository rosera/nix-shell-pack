layout {

   tab name="Pi Agent" {

     pane split_direction="horizontal" {

       // Launch CLAUDE HERE!
       pane command="ollama" {
         name "Pi"
         // args "launch" "pi" "--model" "llama3.2"
         // args "launch" "pi" "--model" "qwen3.6:35b"
         // args "launch" "pi" "--model" "gemma3:latest"
         args "launch" "pi" "--model" "gemma4:e2b"
         start_suspended true
         borderless true
       }

       pane size=1 borderless=true {
         // plugin location="zellij:compact-bar"
         plugin location="zellij:tab-bar"
       }

     }
   }

   tab name="Ollama" focus=true {

     pane split_direction="horizontal" {

       pane split_direction="vertical" {

         pane size="70%" {
         // pane {
           name "Terminal"
         }

         pane split_direction="horizontal" {

           // pane command="ollama" {
           pane size="60%" command="ollama" {
             name "Ollama Server"
             args "serve"
           }

           // pane command="ollama" {
           pane size="20%" command="ollama" {
             name "Ollama Server"
             // args "run" "llama3.2"
             // args "run" "qwen3.6:35b"
             // args "run" "gemma3:latest"
             args "run" "gemma4:e2b"
             start_suspended true
           }

         }

      }

      pane size=1 borderless=true {
        // plugin location="zellij:compact-bar"
        plugin location="zellij:tab-bar"
      }
    }

  }
}
